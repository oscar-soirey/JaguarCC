	 * @param vertices_count Number of vertices.
	 */

@extern void HRL_DrawDebugPolygon(HRL_id _sceneid, HRL_EDebugRenderingType _mode, f32* vertices_x, f32* vertices_y, f32* vertices_z, int vertices_count, f32 r, f32 g, f32 b);
