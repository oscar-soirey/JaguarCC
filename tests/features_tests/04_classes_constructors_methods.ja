class Animal {
    int age;

    constr(int a = 5) {
        age = a;
    }

    int $getAge() {
        return age;
    }

    void $setAge(int a) {
        age = a;
    }
}

namespace h {
    class Dog, Animal {
        string name;

        constr(int a) {
            //name = (string)a;  //jcc ne detecte pas d'erreur
        }
    }
}

void main() {
    h:Dog* d => h:Dog("Buddy");

    sys:print(d.getAge());
    d.setAge(12);
}
