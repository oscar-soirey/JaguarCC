using glfw3;

//ma fonction
void mafonction()
{
    
}

void main(string param) 
{
    int ok = glfwInit();

    mafonction();

    GLFWwindow* win = glfwCreateWindow(
        800,
        600,
        "New Window",
        nullptr,
        nullptr
    );

    while (glfwWindowShouldClose(win) == false)
    {
        glfwPollEvents();
    }

    glfwDestroyWindow(win);
    glfwTerminate();
}
