enum TestEnum {
    A = 1,
    B = 7,
    C,
    D = B + 10
}

struct Fixed {
    u8[4] bytes;
    f32[2] values;
}

@extern void j_variadic(i8* fmt, ...);

@extern void j_fixed(Fixed* value);

void main() {
    Fixed x;
    x.bytes[0] = A;
    x.bytes[1] = D;
    x.values[0] = 1.5;
    j_fixed(&x);
    j_variadic("x=%d", A, D);
}
