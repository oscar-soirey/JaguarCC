using glfw;

void main()
{
  sys:print("ekip");
  i8 ok = glfwInit();
  sys:print("ekip");

  GLFWwindow* win = glfwCreateWindow(
    800,
    600,
    "New Window",
    nullptr,
    nullptr
  );

  while (glfwWindowShouldClose(win) == false)
  {
    glfwPollEvents();
  }

  glfwDestroyWindow(win);
  glfwTerminate();
}